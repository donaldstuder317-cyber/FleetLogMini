    "url": "",
    "w": 570,
    "h": 225,
    "growY": 0,
    "scale": 1,
    "flipX": false,
    "flipY": false,
    "labelColor": "black",
    "color": "blue",
    "fill": "semi",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "1. What problem does the app solve?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Service history lives in spreadsheets, glovebox receipts and memory. Oil changes, brake checks and inspections get missed, and there is no single view of what is due — but enterprise ERP software is overkill for a small fleet."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "shape:geo_3",
   "typeName": "shape",
   "type": "geo",
   "x": 640,
   "y": 140,
   "rotation": 0,
   "index": "a5nNA",
   "parentId": "page:page",
   "isLocked": false,
   "opacity": 1,
   "meta": {},
   "props": {
    "geo": "rectangle",
    "dash": "draw",
    "url": "",
    "w": 570,
    "h": 225,
    "growY": 0,
    "scale": 1,
    "flipX": false,
    "flipY": false,
    "labelColor": "black",
    "color": "blue",
    "fill": "semi",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "2. Who are the users?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Small-fleet owner / maintenance lead (ONE user type for v1) — e.g. a landscaping company, contractor, farm or rental shop running 3–30 vehicles, mowers, generators or field hardware."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "shape:geo_4",
   "typeName": "shape",
   "type": "geo",
   "x": 40,
   "y": 390,
   "rotation": 0,
   "index": "a6RqM",
   "parentId": "page:page",
   "isLocked": false,
   "opacity": 1,
   "meta": {},
   "props": {
    "geo": "rectangle",
    "dash": "draw",
    "url": "",
    "w": 570,
    "h": 225,
    "growY": 0,
    "scale": 1,
    "flipX": false,
    "flipY": false,
    "labelColor": "black",
    "color": "green",
    "fill": "semi",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "3. What are their primary goals?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "See at a glance what is Good / Due Soon / Overdue · log a service in under 30 seconds · see what is coming up (30 days or 500 mi) · export clean history for audits, resale or the accountant."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "shape:geo_5",
   "typeName": "shape",
   "type": "geo",
   "x": 640,
   "y": 390,
   "rotation": 0,
   "index": "a7g7j",
   "parentId": "page:page",
   "isLocked": false,
   "opacity": 1,
   "meta": {},
   "props": {
