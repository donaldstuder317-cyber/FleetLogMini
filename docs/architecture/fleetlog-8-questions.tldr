    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Equipment & Preventive Maintenance Tracker · answers for OUR app"
        }
       ]
      }
     ]
    },
    "scale": 1,
    "autoSize": false
   }
  },
  {
   "id": "shape:geo_2",
   "typeName": "shape",
   "type": "geo",
