    "w": 570,
    "h": 225,
    "growY": 0,
    "scale": 1,
    "flipX": false,
    "flipY": false,
    "labelColor": "black",
    "color": "green",
    "fill": "semi",
    "size": "s",
    "font": "draw",
    "align": "start",
    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "4. What information do they need?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Asset name & type, current odometer / engine hours, service schedules (task + interval by miles, hours or days), last service date & reading, next due point, status badge, parts cost, notes, open fault reports."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "shape:geo_6",
   "typeName": "shape",
