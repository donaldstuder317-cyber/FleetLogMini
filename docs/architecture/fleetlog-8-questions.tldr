        {
         "type": "text",
         "text": "6. What pages are required?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Dashboard · Asset Detail · Log Service · Upcoming Alerts · Export"
        }
       ]
      }
     ]
    }
   }
  },
  {
