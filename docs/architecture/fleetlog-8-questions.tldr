    "verticalAlign": "start",
    "richText": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "5. What actions can they perform?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Create / edit / delete assets, schedules, service logs and fault reports · update odometer / hours · filter alerts (window, asset, task) · sort by urgency · export CSV or printable PDF."
        }
       ]
      }
     ]
    }
   }
  },
