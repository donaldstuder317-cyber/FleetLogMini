      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "7. What data must be collected?"
        }
       ]
      },
      {
       "type": "paragraph"
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Asset (name, type, serial/VIN, meter unit, current reading) · Schedule (task type, interval value + unit) · Service log (date, odometer/hours, task type, parts cost, notes) · Fault report (date, severity, description, resolved?)."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "shape:geo_9",
